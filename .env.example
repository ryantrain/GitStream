APP_NAME=GitStream API
ENV=dev
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://gitstream:gitstream@localhost:5432/gitstream

# Example: user/team ID from auth provider
DEFAULT_TENANT_ID=dev-tenant

# GitHub personal access token (optional, increases API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=
